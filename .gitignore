# SpellForce - Exclude large binary game files
*.pak

# cached files
src/TirganachReloaded/data/cache/*

# other extra files we dont need in the repo
ModdingTools/Inspiration/*
ExtractedAssets/*
!ExtractedAssets/UI/

# Executables and DLLs (game binaries)
*.exe
*.dll

# Video files
*.bik

# Texture files (can be large)


# Other binary formats
*.ico

# System files
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/

# Test artifacts (should be in src/tests/test_outputs/, but ignore if created in root)
test_spell_export/
test_template_export/
test_cff_export/

# Keep these important files (override above patterns if needed)
# Use git add -f to force add if needed
.rsworktree/

# Original game files - ignore everything except specific folders
OriginalGameFiles/*
!OriginalGameFiles/data/
!OriginalGameFiles/script/
